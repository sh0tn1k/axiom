---
import { getCollection, render, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { rubrics } from '../../data/rubrics';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const author = await getEntry(article.data.author);
const base = import.meta.env.BASE_URL;
const rubric = rubrics[article.data.rubric];

const all = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const similar = all
  .filter((a) => a.id !== article.id && a.data.rubric === article.data.rubric)
  .slice(0, 3);
if (similar.length < 3) {
  for (const a of all) {
    if (similar.length >= 3) break;
    if (a.id !== article.id && !similar.find((s) => s.id === a.id)) similar.push(a);
  }
}

function asset(path: string) {
  return path.startsWith('http') ? path : `${base}${path.replace(/^\//, '')}`;
}

const pageUrl = new URL(`${base}article/${article.id}/`, Astro.site).href;
const shareText = encodeURIComponent(article.data.title);
const shareUrl = encodeURIComponent(pageUrl);
---
<BaseLayout title={article.data.title} description={article.data.description} ogImage={asset(article.data.cover)}>
  <Header />
  <main class="main">
    <div class="container">
      <article class="article-hero">
        <div class="meta-row">
          <a class="rubric-tag" href={`${base}rubric/${rubric.slug}/`}>{rubric.title}</a>
          <time datetime={article.data.pubDate.toISOString()}>
            {article.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>
        <h1>{article.data.title}</h1>
        <p style="color:var(--text-muted);max-width:640px;">{article.data.description}</p>
        <div class="cover">
          <img src={asset(article.data.cover)} alt="" width="1080" height="608" />
        </div>
      </article>

      {author && (
        <AuthorByline
          name={author.data.name}
          role={author.data.role}
          avatar={asset(author.data.avatar)}
          href={`${base}author/${author.id}/`}
        />
      )}

      <div class="prose">
        <Content />
      </div>

      <div class="share">
        <span>Поделиться</span>
        <a href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener noreferrer">Telegram</a>
        <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener noreferrer">X</a>
        <a href={`https://news.ycombinator.com/submitlink?u=${shareUrl}&t=${shareText}`} target="_blank" rel="noopener noreferrer">HN</a>
      </div>

      <h2 class="section-title">Похожие материалы</h2>
      <div class="similar-grid">
        {similar.map((a) => (
          <a class="similar-card" href={`${base}article/${a.id}/`}>
            <div class="thumb"><img src={asset(a.data.cover)} alt="" loading="lazy" /></div>
            <div class="body">
              <h3>{a.data.title}</h3>
              <div class="date">{a.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short', year: 'numeric' })}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
