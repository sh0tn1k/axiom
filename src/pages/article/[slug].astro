---
import { getCollection, render, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { rubrics } from '../../data/rubrics';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const author = await getEntry(article.data.author);
const base = import.meta.env.BASE_URL;
const rubric = rubrics[article.data.rubric];

const all = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const similar = all
  .filter((a) => a.id !== article.id && a.data.rubric === article.data.rubric)
  .slice(0, 3);
if (similar.length < 3) {
  for (const a of all) {
    if (similar.length >= 3) break;
    if (a.id !== article.id && !similar.find((s) => s.id === a.id)) similar.push(a);
  }
}

function asset(path: string) {
  return path.startsWith('http') ? path : `${base}${path.replace(/^\//, '')}`;
}

const pageUrl = new URL(`${base}article/${article.id}/`, Astro.site).href;
const shareText = encodeURIComponent(article.data.title);
const shareUrl = encodeURIComponent(pageUrl);
const dateStr = article.data.pubDate.toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<BaseLayout title={article.data.title} description={article.data.description} ogImage={asset(article.data.cover)}>
  <Header />
  <main class="main article-page">
    <div class="container article-shell">
      <article class="article-hero reveal">
        <div class="article-hero-glass">
          <div class="meta-row meta-chips">
            <a class="chip chip-rubric" href={`${base}rubric/${rubric.slug}/`}>{rubric.title}</a>
            <time class="chip chip-date" datetime={article.data.pubDate.toISOString()}>{dateStr}</time>
          </div>
          <h1>{article.data.title}</h1>
          <p class="article-lead">{article.data.description}</p>
        </div>

        <div class="cover cover-cinematic">
          <img src={asset(article.data.cover)} alt="" width="1080" height="608" />
          <div class="cover-vignette" aria-hidden="true"></div>
          <div class="cover-fade" aria-hidden="true"></div>
        </div>
      </article>

      {author && (
        <AuthorByline
          name={author.data.name}
          role={author.data.role}
          avatar={asset(author.data.avatar)}
          href={`${base}author/${author.id}/`}
        />
      )}

      <div class="prose reveal-delay">
        <Content />
      </div>

      <div class="share share-bar reveal">
        <span class="share-label">Поделиться</span>
        <div class="share-chips">
          <a href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener noreferrer">Telegram</a>
          <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener noreferrer">X</a>
          <a href={`https://news.ycombinator.com/submitlink?u=${shareUrl}&t=${shareText}`} target="_blank" rel="noopener noreferrer">HN</a>
        </div>
      </div>

      <section class="similar-panel reveal">
        <h2 class="section-title section-title-glass">Похожие материалы</h2>
        <div class="similar-grid">
          {similar.map((a) => (
            <a class="similar-card" href={`${base}article/${a.id}/`}>
              <div class="thumb">
                <img src={asset(a.data.cover)} alt="" loading="lazy" />
                <div class="thumb-sheen" aria-hidden="true"></div>
              </div>
              <div class="body">
                <h3>{a.data.title}</h3>
                <div class="date">{a.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short', year: 'numeric' })}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
