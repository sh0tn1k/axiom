---
interface Props {
  name: string;
  role: string;
  avatar: string;
  href: string;
}

const { name, role, avatar, href } = Astro.props;
---
<a class="byline" href={href}>
  <img src={avatar} alt="" width="48" height="48" />
  <div>
    <div class="name">{name}</div>
    <div class="role">{role}</div>
  </div>
</a>
