---
interface Props {
  name: string;
  role: string;
  avatar: string;
  href: string;
}

const { name, role, avatar, href } = Astro.props;
---
<a class="byline byline-card" href={href}>
  <div class="byline-avatar">
    <span class="byline-halo" aria-hidden="true"></span>
    <img src={avatar} alt="" width="52" height="52" />
  </div>
  <div class="byline-text">
    <div class="byline-label">Автор</div>
    <div class="name">{name}</div>
    <div class="role">{role}</div>
  </div>
  <span class="byline-arrow" aria-hidden="true">→</span>
</a>
