---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const links = [
  { href: base, label: 'Главная', match: (p: string) => p === base || p === `${base}`.replace(/\/$/, '') + '/' },
  { href: `${base}rubric/models/`, label: 'Рубрики', match: (p: string) => p.includes('/rubric/') },
  { href: `${base}search/`, label: 'Поиск', match: (p: string) => p.includes('/search') },
  { href: `${base}about/`, label: 'О проекте', match: (p: string) => p.includes('/about') },
];
---
<header class="site-header">
  <div class="container inner">
    <a class="logo" href={base}>AXIOM</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" id="nav-toggle">Меню</button>
    <nav class="nav" id="site-nav">
      {links.map((l) => (
        <a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
